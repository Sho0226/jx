{
  "manifest_version": 3,
  "name": "JIRA → GFM Copy",
  "version": "0.1.0",
  "description": "JIRAのテキストをGFMに変換してワンクリックでコピー",
  "permissions": ["clipboardWrite"],
  "host_permissions": [
    "https://*.atlassian.net/*",
    "https://jira.*/*",
    "https://*.jira.*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.atlassian.net/*",
        "https://jira.*/*",
        "https://*.jira.*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
